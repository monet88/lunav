{
  "name": "lunav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint scripts --max-warnings=0",
    "security:client": "node scripts/check-client-secrets.mjs",
    "test": "turbo run test test:root",
    "test:root": "vitest run scripts/tests scripts/check-client-secrets.test.ts",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.10.1",
    "eslint": "^10.6.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.1.10"
  }
}